[MESSAGES CONTROL]
# Отключаем не более двух правил с обоснованием:
# 1. C0114 (missing-module-docstring) — избыточно для небольшого учебного модуля, назначение которого очевидно из имени файла.
# 2. R0903 (too-few-public-methods) — учебный класс Shop предназначен только для хранения и добавления товаров, поэтому наличие одного публичного метода обосновано.
disable=
    missing-module-docstring,
    too-few-public-methods

# Включаем важное правило (W0612: unused-variable — обнаружение неиспользуемых переменных)
enable=
    unused-variable
